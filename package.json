{
  "name": "stock-animation",
  "description": "Turn a stock's daily closes into a 30-second animated chart you can download as an MP4.",
  "license": "MIT",
  "author": "Keith Li",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"wrangler dev --port 8787 --ip 127.0.0.1 --var ALLOWED_ORIGIN:http://localhost:5173,http://127.0.0.1:5173\"",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p workers/api/tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p workers/api/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.69.0"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "mediabunny": "^1.61.6"
  }
}
